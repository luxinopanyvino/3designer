{"nodes": [{"id": "readme_printcad", "label": "PrintCAD (AI local 3D print design tool)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_generation_pipeline", "label": "Prompt to CadQuery generation pipeline (LLM -> AST check -> sandbox -> mesh validation)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The generated CadQuery code is kept as the single source of truth so refinements ('make it 10mm wider') edit code rather than meshes, producing exact watertight B-rep solids ready for the slicer."}, {"id": "readme_self_correction_loop", "label": "Self-correction loop (3 attempts, traceback fed back to LLM)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local models fail often enough that the orchestrator retries up to 3 times, returning the execution traceback to the LLM so it can repair its own script."}, {"id": "readme_ast_sandbox", "label": "AST allowlist + subprocess sandbox", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allowlist limits imports to cadquery/math/numpy with no I/O; sandbox is AST check + isolated subprocess + timeout. Explicitly pragmatic for a personal local tool, not a security boundary against a hostile model."}, {"id": "readme_cadquery", "label": "CadQuery (parametric CAD library)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": "https://cadquery.readthedocs.io/", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ollama", "label": "Ollama (local model runtime)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": "https://ollama.com", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_qwen25_coder", "label": "qwen2.5-coder:14b (code generation model)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as default PRINTCAD_MODEL_CODE because it fits in 16 GB VRAM (~9 GB); models >16 GB like qwen3.6 overflow VRAM."}, {"id": "readme_qwen3_vl", "label": "qwen3-vl:8b (vision model for image-to-CAD)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional vision model; Ollama swaps it with the code model in VRAM automatically. Extracts a structured brief (part type, holes, proportions) that feeds generation; the user's text supplies real dimensions."}, {"id": "readme_organic_mode", "label": "Organic mode (photo to neural mesh)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exists for figures/sculptures that parametric CAD cannot express. Exports STL/3MF only: a neural mesh has no B-rep, so no STEP export and no 'View code'. Backend repairs the raw mesh (largest component, holes, normals) and rests it on the bed."}, {"id": "readme_trellis", "label": "TRELLIS (Microsoft, default organic engine)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roadmap item completed: TRELLIS replaced TripoSR as default for higher quality; ORGANIC_ENGINE=triposr reverts to the old engine."}, {"id": "readme_triposr", "label": "TripoSR (legacy organic engine)", "file_type": "concept", "source_file": "README.md", "source_locati