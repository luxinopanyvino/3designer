{"nodes": [{"id": "backend_app_prompts_system_cadquery_system_prompt", "label": "CadQuery system prompt (rules + cheat sheet + few-shots)", "file_type": "document", "source_file": "backend/app/prompts/system_cadquery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_app_prompts_system_cadquery_output_rules", "label": "Strict output rules (one python block, result var, mm, UPPER_CASE params, z>=0)", "file_type": "rationale", "source_file": "backend/app/prompts/system_cadquery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constrains LLM output so the sandbox can execute it deterministically: exactly one fenced python block, final solid in `result`, only cadquery/math/numpy imports (matches the AST allowlist), part resting on z=0 oriented for FDM printing, minimum wall 1.2 mm."}, {"id": "backend_app_prompts_system_cadquery_cheat_sheet", "label": "CadQuery cheat sheet (API calls covering most functional parts)", "file_type": "concept", "source_file": "backend/app/prompts/system_cadquery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inlines the subset of the CadQuery 2.x API (box, extrude, hole, shell, union/cut, selectors, rarray) plus metric hole diameters so a local model does not hallucinate API signatures."}, {"id": "backend_app_prompts_system_cadquery_fillet_chamfer_rules", "label": "Fillet/chamfer rules (decorative, omit when in doubt)", "file_type": "rationale", "source_file": "backend/app/prompts/system_cadquery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Edge selectors like |Z match straight edges only; circular edges on cylinders need >Z/<Z and chamfers. Fillets are treated as decorative: after a fillet error the model should omit them, since fillet failures (BRep_API: command not done) are the most common OCCT crash mode."}, {"id": "backend_app_prompts_system_cadquery_few_shot_examples", "label": "Few-shot examples (bracket, hub, L-bracket, box)", "file_type": "concept", "source_file": "backend/app/prompts/system_cadquery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four worked examples demonstrating the output contract; the L-bracket example explicitly teaches that an L-bracket is two perpendicular plates, correcting a common model misconception."}], "edges": [{"source": "backend_app_prompts_system_cadquery_system_prompt", "target": "backend_app_prompts_system_cadquery_output_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/app/prompts/system_cadquery.md", "source_location": null, "weight": 1.0}, {"source": "backend_app_prompts_system_cadquery_system_prompt", "target": "backend_app_prompts_system_cadquery_cheat_sheet", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/app/prompts/system_cadquery.md", "source_location": null, "weight": 1.0}, {"source": "backend_app_prompts_system_cadquery_system_prompt", "target": "backend_app_prompts_system_cadquery_fillet_chamfer_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/app/prompts/system_cadquery.md", "source_location": null, "weight": 1.0}, {"source": "backend_app_prompts_system_cadquery_system_prompt", "target": "backend_app_prompts_system_cadquery_few_shot_examples", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/app/prompts/system_cadquery.md", "source_location": null, "weight": 1.0}, {"source": "backend_app_prompts_system_cadquery_cheat_sheet", "target": "readme_cadquery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backen